// Pura Esencia - Prisma schema (PostgreSQL)
// Producción: Neon (serverless, tier gratis). Local: Postgres con socket.
// price: Int en pesos COP (enteros, sin decimales).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id        String   @id @default(cuid())
  name      String   @default("Pura Esencia")
  phone     String   @default("")
  whatsapp  String   @default("")
  logo      String   @default("")
  password  String   @default("admin123")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String     @id @default(cuid())
  name      String
  image     String     @default("")
  sortOrder Int        @default(0)
  isHidden  Boolean    @default(false)
  menuItems MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([sortOrder])
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  slug        String?  @unique
  price       Int      @default(0)
  description String   @default("")
  images      String   @default("[]")
  imageBlur   String   @default("")
  likes       Int      @default(0)
  isFeatured  Boolean  @default(false)
  isHidden    Boolean  @default(false)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([isFeatured])
  @@index([isHidden])
  @@index([likes])
}
