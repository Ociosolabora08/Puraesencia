# Pura Esencia - Environment Variables
# Copy this file to .env for local development
# For Render deployment, set these in the Render dashboard

# Database URL - PostgreSQL connection string
# Local development (Neon, Supabase, or local Postgres):
# Example: postgresql://user:password@host:5432/database?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/pura_esencia?schema=public"

# Admin session secret - any random string for cookie signing
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET="dev-secret-change-in-production"
