# Pura Esencia — Variables de entorno
# Copia este archivo a .env.local para desarrollo local.
# En producción (Vercel) se configuran en: Project Settings → Environment Variables.

# ── Base de datos (Neon Postgres gratis) ─────────────────────────────
# Local:  postgresql://jhonierpro:pura_local_dev@localhost:5432/puraesencia?schema=public
# Neon:   postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/pura_esencia?schema=public"

# ── Seguridad ────────────────────────────────────────────────────────
# Secreto para firmar el JWT de sesión admin. Generar con:
#   openssl rand -base64 32
AUTH_SECRET=""
# Contraseña admin usada SOLO por el seed inicial (prisma/seed.ts).
# Si no se define, el seed genera una aleatoria y la imprime por consola.
SEED_ADMIN_PASSWORD=""

# ── Rate limiting login (Upstash Redis gratis) ───────────────────────
# Dashboard Upstash → REST API. Si quedan vacías en dev, se usa
# fallback en memoria (no válido en serverless/producción).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Imágenes (Vercel Blob, 1GB gratis) ───────────────────────────────
# Vercel → Storage → Create Blob Store → copiar token
BLOB_READ_WRITE_TOKEN=""

# ── Sitio público ────────────────────────────────────────────────────
# URL final sin slash final. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL="https://tu-proyecto.vercel.app"
